# Copy to .env and edit. .env is ignored by git.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# 127.0.0.1 = only reachable from this host. 0.0.0.0 = every interface.
BIND_ADDR=127.0.0.1
PROMETHEUS_RETENTION=15d
# Demo PostgreSQL (superuser) and the read-only pg_monitor login used by postgres_exporter.
# Only applied when the postgres-data volume is created for the first time.
POSTGRES_PASSWORD=change-me-too
PG_EXPORTER_PASSWORD=change-me-as-well
